# Variáveis das funções Python. Os valores reais ficam só no painel da Vercel
# (Settings > Environment Variables), separados para Production e Preview.
# Nunca commite valores reais.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=

# Mercado Pago: no sandbox, credenciais de produção da conta de VENDEDOR DE TESTE
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Só no sandbox: email de uma conta COMPRADORA DE TESTE (o Pix sai como APRO e é aprovado sozinho)
MP_EMAIL_PAGADOR_TESTE=

# Brevo (EMAIL_REMETENTE precisa estar verificado no Brevo: "Nome <email>" ou só o email)
BREVO_API_KEY=
EMAIL_REMETENTE=

# Segredo compartilhado com o Database Webhook (o mesmo valor vai no Vault do Supabase)
EMAIL_WEBHOOK_SECRET=

# Assinatura do QR Code das certidões
QR_SECRET=

# Google Maps (chave restrita por dominio; vai para o navegador)
GOOGLE_MAPS_API_KEY=
